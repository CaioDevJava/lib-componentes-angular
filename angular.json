{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "component-library-angular": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "library",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist-app",
            "index": "src/index.html",
            "main": "src/storybook-main.ts",
            "tsConfig": "tsconfig.lib.json",
            "assets": [],
            "styles": ["src/styles.css"]
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": { "browserTarget": "component-library-angular:build", "port": 6006 }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": { "browserTarget": "component-library-angular:build", "outputDir": "storybook-static" }
        }
      }
    }
  },
  "cli": {
    "analytics": "fed2c09b-713e-4759-8a98-85cef747b56a"
  }
}
